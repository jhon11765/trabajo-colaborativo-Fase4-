#clase abstracta 

class EntidadBase(ABC):
def __init__(self, id_entidad):
self._id_entidad = str(id_entidad).strip()
if not self._id_entidad:
raise ValueError("el id es obligatorio")

@property
def id_entidad(self):
return self._id_entidad
@abstractmethod
def obtener_resumen(self):
pass
#clase cliente 
class cliente(EntidadBase):
def__init__(self, id_cliente, nombre, correo, telefono):
super().__init__(id_cliente)

self.__nombre =""
self.__correo =""
self.__telefono =""

self.set_nombre(nombre)
self.set_correo(correo)
self.set_telefono(telefono)

def set_nombre(self,nombre):
nombre = str(nombre).strip()

if len(nombre) < 3:
raise clienteInvalidoException("el nombre debe tener minimo 3 caracteres")
self.__nombre=nombre
def get_nombre(self):
return self._nombre

def set_correo(self, correo):
correo = str(correo).strip()
if "@" not  in correo or "." not in correo:
raise clienteInvalidoException("el correo no es valido")
 self.__correo = correo

def get_correo(self):
return self.__correo

def set_telefono(self, telefono):
telefono = str(telefono).strip()

if not telefono.isdigit() or len(telefono) < 7:
raise clienteInvalidoException("el telefono debe terner 7 digitos")

self.__telefono = telefono

def get_telefono(self):
return self.__telefono

def obtener_resumen(self):
return(
f"cliente: {self.__nombre}",
f"correo: {self.__correo}",
f"telefono: {self.__telefono}")

#clase abstracta de servicio

class servicio(EntidadBase):

def__init__(self,id_servicio, nombre, tarifa):
super().__init__(id_servicio)

self.nombre_servicio = str(nombre).strip()
self.tarifa_base = float(tarifa)

if not self.nombre_servicio or self.tarifa_base <=0:
raise servicioNoDisponibleException("el nombre y la tarifa deben ser validos")

@abstractmethod
def validar_parametros(self, duracion):
pass

@abstractmethod
def calcular_costo(self, duracion, descuento=0):
pass

@abstractmethod
def describir_servicio(self):
pass

#servicio de reserva de salas 

class reservaSalas(servicio):

def __init__(self, id_servicio, nombre, tarifa, capacidad):
super().__init__(id_servicio, nombre, tarifa)

self.capacidad = int(capacidad)
def validar_parametros(self, horas):
try:
horas = float(horas)
if horas <= 0 or horas > 12:
raise servicioNoDisponibleException(
"la sala se puede reservar entre 0 y 12 horas")

except ValueError as error:
raise servicioNoDisponibleException(
"las horas deben ser numericas")from error

def calcular_costo(self, horas, descuento=0):
try:
self.validar_parametros(horas)

subtotal = float(horas) * self.tarifa_base

subtotal -= subtotal * (descuento / 100)

iva = subtotal * 0.19
total = subtotal + iva 

if total < 0:
raise calculoInconsistenteException("el costo no puede ser negativo")

except Exception as error:
registrar_log ("error", str(error))
raise
else:
registrar_log("INFO", "costo de sala calculado")
return total

finally:
registrar_log("INFO", "finalizo calculo de sala")

def describir_servicio(self):
return (
f"sala {self.nombre_servivio}",
f"capacidad {self.capacidad}", 
f"tarifa por hora {self.tarifa_base}")

def obtener_resumen(self):
return self.describir_servicio()

