class AlquilerEquipos(servicio):

def__init__(self, id_servicio, nombre, tarifa, deposito):
super().__init__(id_servicio, nombre, tarifa)

self.deposito = float(deposito)

def validar_parametros(self, dias):
try:
dias = int(dias)

if dias < 1 or dias > 90:
raise servicioNoDisponibleException(" el alquiler debe ser entre 1 y 90 dias")

except ValueError as error:
raise servicioNoDisponibleException(
"los dias deben ser numeros enteros") from error 

def calcular_costo(self, dias, descuento=0):
self.validar_parametros(dias)

subtotal = int(dias) * self.tarifa_base

if int(dias) >= 7:
subtotal *= 0.85

subtotal -=subtotal * (descuento /100)
return subtotal + self.deposito

def describir_servicio(self):
return(
f"equipo {self.nombre_servicio}",
f"tarifa diaria {self.tarifa_base}",
f"deposito {self.deposito}" )

def obtener_resumen(self):
return self.describir_servicio()

