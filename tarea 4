format = "%(asctime)s - %(levelname)s - %(message)s",)

def registrar_log(nivel, mensaje):
if nivel == "INFO":
logging.info(mensaje)
elif nivel == "advertencia":
logging.advertencia(mensaje)
elif nivel == " error":
logging.error(mensaje)
